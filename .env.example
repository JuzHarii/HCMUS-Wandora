ENVIRONMENT=development
DEBUG=false
# Copy the Session pooler URI from Supabase Dashboard > Connect, then replace
# [YOUR-PASSWORD].  The `postgresql+psycopg` driver prefix is required by SQLAlchemy.
# Do not commit the actual URI or password.
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# `session` is suited to this long-running FastAPI server. Set `transaction`
# only when deploying to serverless/edge infrastructure.
DB_POOL_MODE=session
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Generate a random value of at least 32 characters for deployed environments.
# The development fallback is only intended for local setup.
JWT_SECRET_KEY=change-this-development-secret-before-deploying
JWT_EXPIRE_MINUTES=10080
